{
  "scheme_code": "scss",
  "scheme_name": "Senior Citizen Savings Scheme (SCSS)",
  "language": "en",
  "form_title": "Form-1 Application for Opening of SCSS Account",
  "source_pdf": "assets/forms/form1_en_v2024.pdf",
  "pages": 2,
  "required_fields": [
    "applicant_name",
    "dob",
    "pan",
    "mobile",
    "address",
    "pincode",
    "initial_deposit",
    "nominee_name",
    "nominee_relationship",
    "nominee_share"
  ],
  "optional_fields": [
    "father_or_spouse_name",
    "gender",
    "aadhaar",
    "email",
    "district",
    "state",
    "post_office",
    "deposit_mode",
    "nominee_dob",
    "place"
  ],
  "validation_rules": {
    "applicant_name": {
      "type": "string",
      "min_length": 2,
      "max_length": 80,
      "error_message": "Applicant name must be provided."
    },
    "dob": {
      "type": "regex",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|\\d{2}/\\d{2}/\\d{4})$",
      "error_message": "Date of birth must be in YYYY-MM-DD or DD/MM/YYYY format."
    },
    "pan": {
      "type": "regex",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
      "error_message": "Invalid PAN format. Must be 10 characters (e.g. ABCDE1234F)."
    },
    "mobile": {
      "type": "regex",
      "pattern": "^[6-9]\\d{9}$",
      "error_message": "Invalid Indian mobile number. Must be 10 digits starting with 6-9."
    },
    "pincode": {
      "type": "regex",
      "pattern": "^[1-9][0-9]{5}$",
      "error_message": "Invalid PIN code. Must be a valid 6-digit postal code."
    },
    "initial_deposit": {
      "type": "numeric",
      "min_val": 1000,
      "max_val": 3000000,
      "error_message": "SCSS deposit must be between ₹1,000 and ₹30,00,000 (in multiples of ₹1,000)."
    },
    "nominee_name": {
      "type": "string",
      "min_length": 2,
      "max_length": 80,
      "error_message": "Nominee name is required."
    },
    "nominee_relationship": {
      "type": "string",
      "min_length": 2,
      "max_length": 40,
      "error_message": "Nominee relationship is required."
    },
    "nominee_share": {
      "type": "numeric",
      "min_val": 1,
      "max_val": 100,
      "error_message": "Nominee share must be between 1% and 100%."
    }
  },
  "field_coordinates": {
