{
  "scheme_code": "ssa",
  "scheme_name": "Sukanya Samriddhi Account (SSA)",
  "language": "en",
  "form_title": "Form-1 Application for Opening of Sukanya Samriddhi Account",
  "source_pdf": "assets/forms/form1_en_v2024.pdf",
  "pages": 2,
  "required_fields": [
    "applicant_name",
    "minor_name",
    "minor_dob",
    "guardian_relationship",
    "pan",
    "mobile",
    "address",
    "pincode",
    "initial_deposit"
  ],
  "optional_fields": [
    "father_or_spouse_name",
    "birth_cert_reg_no",
    "aadhaar",
    "email",
    "district",
    "state",
    "post_office",
    "deposit_mode",
    "nominee_name",
    "nominee_relationship",
    "nominee_share",
    "place"
  ],
  "validation_rules": {
    "applicant_name": {
      "type": "string",
      "min_length": 2,
      "max_length": 80,
      "error_message": "Guardian name must be provided."
    },
    "minor_name": {
      "type": "string",
      "min_length": 2,
      "max_length": 80,
      "error_message": "Girl child's full name must be provided."
    },
    "minor_dob": {
      "type": "regex",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|\\d{2}/\\d{2}/\\d{4})$",
      "error_message": "Girl child's date of birth must be in YYYY-MM-DD or DD/MM/YYYY format."
    },
    "guardian_relationship": {
      "type": "string",
      "min_length": 2,
      "max_length": 40,
      "error_message": "Relationship with girl child (Father / Mother / Legal Guardian) is required."
    },
    "pan": {
      "type": "regex",
      "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
      "error_message": "Invalid PAN format. Must be 10 characters (e.g. ABCDE1234F)."
    },
    "mobile": {
      "type": "regex",
      "pattern": "^[6-9]\\d{9}$",
      "error_message": "Invalid Indian mobile number. Must be 10 digits starting with 6-9."
    },
    "pincode": {
      "type": "regex",
      "pattern": "^[1-9][0-9]{5}$",
      "error_message": "Invalid PIN code. Must be a valid 6-digit postal code."
    },
    "initial_deposit": {
      "type": "numeric",
      "min_val": 250,
      "max_val": 150000,
      "error_message": "Sukanya Samriddhi initial deposit must be between ₹250 and ₹1,50,000 per financial year."
    }
  },
